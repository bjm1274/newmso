{
  "name": "allerp",
  "version": "1.0.0",
  "description": "AIIERP PC Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "files": [
      "main.js",
      "package.json"
    ],
    "appId": "com.pchos.allerp",
    "productName": "AllERP",
    "win": {
      "target": "nsis",
      "icon": "icon-new.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AIIERP"
    }
  },
  "author": "SY INC",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
