{
  "name": "newmso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "preview:cloudflare": "npx @opennextjs/cloudflare preview",
    "deploy:cloudflare": "npx @opennextjs/cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "sync:save": "node scripts/sync.mjs save",
    "sync:load": "node scripts/sync.mjs load",
    "deploy": "node scripts/deploy.mjs",
