    "test:e2e": "playwright test --grep-invert @real-db",
    "test:e2e:headed": "playwright test --grep-invert @real-db --headed",
    "test:e2e:real": "playwright test --grep @real-db",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:a11y": "playwright test --project=a11y-chromium",
