    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.43.0",
    "@cloudflare/workers-types": "^4.20260517.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@opennextjs/cloudflare": "^1.19.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
